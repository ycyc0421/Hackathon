[Unit]
Description=Check official rule sources and queue changes for review

[Service]
Type=oneshot
WorkingDirectory=%h/app/rule-monitor
ExecStart=%h/app/rule-monitor/.venv/bin/python backend/tools/crawl_rule_sources.py --catalog %h/app/rule-monitor/backend/app/rules/source_catalog.json --output %h/app/shared/rule-sources
TimeoutStartSec=10min
MemoryMax=512M
CPUQuota=50%
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
