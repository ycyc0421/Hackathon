# 复制为 .env 后按需修改；服务启动时不会自动读取 .env
# 可用 uvicorn app.main:app --env-file .env 或设置系统环境变量

TZ_OFFSET_HOURS=8
MAX_FILE_SIZE_MB=20
MAX_FILE_COUNT=10
POST_WAIT_MS=1500
MIN_TEXT_LAYER_CHARS=40

# 多模态识别服务（可选；不要在这里填写真实密钥）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60
