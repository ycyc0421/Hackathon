# 复制为 .env 后按需修改；服务启动时不会自动读取 .env
# 可用 uvicorn app.main:app --env-file .env 或设置系统环境变量

TZ_OFFSET_HOURS=8
MAX_FILE_SIZE_MB=20
MAX_FILE_COUNT=10
POST_WAIT_MS=1500
MIN_TEXT_LAYER_CHARS=40

# 本地 OCR（需另装 requirements-ocr.txt；CPU 模型首次运行会下载）
PADDLE_OCR_ENABLED=0
PADDLE_OCR_ENGINE=vl
PADDLE_VL_VERSION=v1.6
PADDLE_VL_DEVICE=cpu
PADDLE_VL_CPU_THREADS=4
PADDLE_VL_REC_BACKEND=llama-cpp-server
PADDLE_VL_REC_SERVER_URL=http://127.0.0.1:18083/v1
# 服务器 API 必须指向已预热的独立本机模型服务，避免超过 API 的 8 GiB 上限
# PADDLE_VL_SERVICE_URL=http://127.0.0.1:18082
PADDLE_VL_TIMEOUT_SECONDS=900
# 可固定到预先下载的官方目录；为空时由 Paddle 下载/使用缓存
# PADDLE_VL_MODEL_DIR=/home/deploy-user/app/shared/models/PaddleOCR-VL-1.6
# PADDLE_VL_LAYOUT_DIR=/home/deploy-user/app/shared/models/PP-DocLayoutV3

# 多模态识别服务（可选；不要在这里填写真实密钥）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60
# Optional absolute SQLite runtime path; default: backend/.data/tasks.sqlite3.
TASK_DB_PATH=

# 评测摘要文件；默认 <DATA_DIR>/evaluation/latest.json，历史在同目录 runs/。
# 只在需要指向别处时设置（详见 docs/评测运行.md）。
# EVALUATION_RESULT_PATH=
